# Anthropic Claude — used to synthesize both partners' preferences into a
# search brief, refine the pool between rounds, and improve picks over time.
ANTHROPIC_API_KEY=

# TMDB — used to discover candidate titles and fetch posters/metadata.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# RapidAPI — "OTT details" API (by GoX-ai), used to fetch real IMDb ratings,
# runtime and which Indian OTT platforms carry each title.
# https://rapidapi.com/gox-ai-gox-ai-default/api/ott-details
RAPIDAPI_KEY=

# Supabase — stores sessions, preference profiles, swipe history, matches and
# post-watch ratings. Run supabase/schema.sql in your project's SQL editor
# first. The service role key is required server-side (never exposed to the
# browser) so the Flask app can write on behalf of both partners.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Flask server port (defaults to 5001)
PORT=5001

# Optional: force demo mode even if keys above are present (true/false).
# Demo mode uses a small bundled sample catalog instead of live TMDB/RapidAPI
# calls, and a heuristic brief instead of a live Claude call — handy for UI
# development without burning API quota.
DEMO_MODE=false
